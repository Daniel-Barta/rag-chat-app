{
  "name": "rag-chat-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsup server/index.ts --format esm --sourcemap --clean --target=node20 --outDir dist/server",
    "build:client": "cd client && npm run build",
    "dev:server": "tsup server/index.ts --format esm --watch --sourcemap --target=node20 --outDir dist/server",
    "dev:client": "cd client && npm run start",
    "start": "node dist/server/index.js",
    "start:dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "install:all": "npm install && cd client && npm install",
    "clean": "rimraf dist && cd client && npm run clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"server/**/*.ts\"",
    "format:check": "prettier --check \"server/**/*.ts\"",
    "format:all": "npm run format && cd client && npm run format"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
